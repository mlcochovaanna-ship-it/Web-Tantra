Options -Indexes

# Chybová stránka 404
ErrorDocument 404 /404.html

# Blokace interních souborů (podklady .md, systémové soubory macOS, git)
<FilesMatch "(\.md|\.DS_Store|\.gitignore)$">
    Require all denied
</FilesMatch>

# Bezpečnostní hlavičky
<IfModule mod_headers.c>
    # Vždy otevírat přes HTTPS (1 rok)
    Header always set Strict-Transport-Security "max-age=31536000"
    # Zákaz odhadování typu souboru
    Header always set X-Content-Type-Options "nosniff"
    # Zákaz vložení webu do rámu na cizí stránce
    Header always set X-Frame-Options "SAMEORIGIN"
    # Cizím webům posílat jen doménu, ne celou adresu stránky
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Vypnutí nepoužívaných funkcí prohlížeče
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    # Povolené zdroje: vše z vlastní domény, formuláře na Formspree
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

RewriteEngine On
RewriteBase /

# Přesměrování www → hlavní doména (301 permanent)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# Zrušená stránka cookies → bod Cookies v zásadách (301 permanent)
RewriteRule ^cookies(\.html)?/?$ https://%{HTTP_HOST}/zpracovani-osobnich-udaju#cookies [R=301,L,NE]

# Čisté URL (bez přípony .html)

# Přesměrování /stranka.html → /stranka (301 permanent)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?#] [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L,NE]

# Interní obsluha čistých URL → příslušný .html soubor
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
